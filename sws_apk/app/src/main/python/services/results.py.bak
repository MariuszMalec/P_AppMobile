import re


def get_result_status(result: str | None, team_name: str) -> dict:
    """
    Określa status wyniku dla konkretnej drużyny.

    Zwraca:
        {
            "display_result": str,
            "lose": bool,
        }
    """

    value = result or ""
    display_result = value
    lose = False

    result_lower = value.lower()

    # Winner = wygrana
    if "winner" in result_lower:
        lose = False

    # Brak wyniku / round = przegrana
    elif "round" in result_lower or ":" not in value:
        lose = True

    # Rzuty karne
    if "PEN" in value and ":" in value:
        pen_match = re.search(
            r"\(PEN\s+(\d+):(\d+)\)",
            value,
            re.IGNORECASE,
        )

        if pen_match:
            pen_a = int(pen_match.group(1))
            pen_b = int(pen_match.group(2))

            teams_part = value.split()[0]

            try:
                team_a, team_b = teams_part.split(":", 1)

                if team_name.strip().lower() == team_a.strip().lower():
                    lose = pen_a < pen_b

                elif team_name.strip().lower() == team_b.strip().lower():
                    lose = pen_b < pen_a

            except ValueError:
                pass

    # Wynik po dogrywce
    elif "A.E.T" in value and ":" in value:
        main_part = value.split("(", 1)[0].strip()

        space_index = main_part.find(" ")

        if space_index != -1:
            teams_part = main_part[:space_index].strip()
            score_part = main_part[space_index + 1:].strip()

            teams = teams_part.split(":", 1)
            scores = score_part.split(":", 1)

            if len(teams) == 2 and len(scores) == 2:
                team_a = teams[0].strip()
                team_b = teams[1].strip()
                score_a = scores[0].strip()
                score_b = scores[1].strip()

                if score_a.isdigit() and score_b.isdigit():
                    if team_name.strip().lower() == team_a.lower():
                        lose = int(score_a) < int(score_b)

                    elif team_name.strip().lower() == team_b.lower():
                        lose = int(score_b) < int(score_a)

    # Zwykły wynik
    elif " " in value and ":" in value:
        space_index = value.find(" ")

        teams_part = value[:space_index].strip()
        score_part = value[space_index + 1:].strip()

        teams = teams_part.split(":", 1)
        scores = score_part.split(":", 1)

        if len(teams) == 2 and len(scores) == 2:
            team_a = teams[0].strip()
            team_b = teams[1].strip()
            score_a = scores[0].strip()
            score_b = scores[1].strip()

            if score_a.isdigit() and score_b.isdigit():
                if team_name.strip().lower() == team_a.lower():
                    lose = int(score_a) < int(score_b)

                elif team_name.strip().lower() == team_b.lower():
                    lose = int(score_b) < int(score_a)

    # Stary format, np. Parma:Ajax2:0
    elif ":" in value:
        parts = value.split(":")

        if len(parts) == 3:
            team_a = parts[0].strip()
            team_b_with_score = parts[1].strip()
            score_b = parts[2].strip()

            if score_b.isdigit():

                if team_name.strip().lower() == team_a.lower():
                    score_a = team_b_with_score[-1:]

                    if score_a.isdigit():
                        team_b = team_b_with_score[:-1].strip()

                        display_result = (
                            f"{team_a}:{team_b} "
                            f"{int(score_a)}:{int(score_b)}"
                        )

                        lose = int(score_a) < int(score_b)

                elif team_b_with_score.lower().endswith(
                    team_name.strip().lower()
                ):
                    score_text = team_b_with_score[
                        : -len(team_name.strip())
                    ].strip()

                    if score_text.isdigit():
                        display_result = (
                            f"{team_a}:{team_name} "
                            f"{int(score_text)}:{int(score_b)}"
                        )

                        lose = int(score_b) < int(score_text)

    # Ostateczne zasady
    if "winner" in result_lower:
        lose = False

    elif "round" in result_lower:
        lose = True

    elif value and ":" not in value:
        lose = True

    return {
        "display_result": display_result,
        "lose": lose,
    }
