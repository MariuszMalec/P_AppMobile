                    getFilesDir(),
                    "activity.db"
            );

            appendLog("");
            appendLog("========================================");
            appendLog("PRÓBA USUNIĘCIA BAZY SQLITE");
            appendLog("========================================");
            appendLog("Ścieżka:");
            appendLog(dbFile.getAbsolutePath());

            try {

                if (dbFile.exists()) {

                    appendLog("Baza istnieje.");
                    appendLog("Rozmiar: " + dbFile.length() + " bajtów");

