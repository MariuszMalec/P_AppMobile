        // ============================================
        // DEBUG / RELEASE
        // ============================================

        // Tymczasowo pokazujemy ekran diagnostyczny także w release.
        setContentView(layout);

        appendLog("========================================");
        appendLog("ACTIVITY APK - START");
        appendLog("========================================");
        appendLog("Ekran uruchomiony.");
        appendLog("Uruchamiam Python...");

        // ============================================
        // PYTHON
        // ============================================

        try {

            if (!Python.isStarted()) {
                Python.start(new AndroidPlatform(this));
