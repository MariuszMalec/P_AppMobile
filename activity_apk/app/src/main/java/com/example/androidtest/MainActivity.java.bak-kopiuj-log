            e.printStackTrace(new PrintWriter(sw));
            appendLog(sw.toString());

            return;
        }

        // ============================================
        // START FASTAPI W TLE
        // ============================================

        Thread pythonThread = new Thread(() -> {

            try {

                appendLog("Pobieram instancję Python...");

                Python py = Python.getInstance();

                appendLog("Importuję moduł server...");

